{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lian@育种台",
  "version": "0.1.0",
  "identifier": "com.linmoqian.podagent",
  "build": {
    "beforeDevCommand": "pnpm build:agent && pnpm prepare:tauri-resources && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && pnpm build:agent && pnpm fetch:node-runtime",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "lian@育种台",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 23 },
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../dist-agent/agent.mjs": "agent/agent.mjs",
      "../dist-agent/agent-resources": "agent-resources",
      "../dist-agent/node-runtime": "node-runtime"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
