# Pod Agent 本地 Agent 进程配置（agent/agent.ts）
# provider 与 model id 取自 pi-ai 内置模型目录，API key 环境变量名按 provider 决定
MODEL_PROVIDER=deepseek
MODEL_ID=deepseek-v4-flash
DEEPSEEK_API_KEY=replace-with-your-api-key
# 其他 provider 示例：OPENAI_API_KEY / GEMINI_API_KEY / DEEPSEEK_API_KEY / XAI_API_KEY

# YOLO 工具使用的 Python 解释器（默认 /Users/lin/miniforge3/bin/python，已装 ultralytics）
# YOLO_PYTHON=/Users/lin/miniforge3/bin/python